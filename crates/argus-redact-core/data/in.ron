// Indian pattern data (SSOT). Mirrors lang/in/patterns.py PATTERNS.
[
    PatternData(
        type_: r"aadhaar",
        label: r"[AADHAAR]",
        pattern: r"(?<!\d)\d{4}[\s-]?\d{4}[\s-]?\d{4}(?!\d)",
        validator: Some(r"aadhaar"),
        description: r"Indian Aadhaar number (12 digits)",
    ),
    PatternData(
        type_: r"pan",
        label: r"[PAN]",
        pattern: r"(?<![A-Za-z])[A-Z]{5}\d{4}[A-Z](?![A-Za-z])",
        validator: Some(r"pan"),
        description: r"Indian PAN card (AAAPL1234C format)",
        // The PAN's fixed AAAAA9999A shape is the same characters regardless of
        // surrounding script, so it must still be caught in en/zh/… text, not
        // only when `in` is requested. (aadhaar above stays language-scoped: it
        // is a bare 12-digit run with no checksum, too collision-prone to widen.)
        language_neutral: true,
    ),
    PatternData(
        type_: r"phone",
        label: r"[PHONE]",
        pattern: r"(?:\+91[-\s]?)?[6-9]\d{4}[-\s]?\d{5}(?!\d)",
        description: r"Indian mobile phone number",
    ),
]
