// Korean pattern data (SSOT). Mirrors lang/ko/patterns.py PATTERNS.
[
    PatternData(
        type_: r"phone",
        label: r"[전화번호]",
        pattern: r"01[016789][- \t]?\d{3,4}[- \t]?\d{4}(?![0-9])",
        description: r"Korean mobile phone (010/011/016/017/018/019)",
    ),
    PatternData(
        type_: r"phone",
        label: r"[전화번호]",
        pattern: r"0[2-6]\d{0,1}[- \t]?\d{3,4}[- \t]?\d{4}(?![0-9])",
        description: r"Korean landline phone",
    ),
    PatternData(
        type_: r"rrn",
        label: r"[주민등록번호]",
        pattern: r"(?<![0-9])\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\d|3[01])-[0-9]\d{6}(?![0-9])",
        description: r"Korean Resident Registration Number (YYMMDD-GXXXXXX)",
    ),
]
