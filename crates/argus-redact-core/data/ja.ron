// Japanese pattern data (SSOT). Mirrors lang/ja/patterns.py PATTERNS.
[
    PatternData(
        type_: r"phone",
        label: r"[電話番号]",
        pattern: r"0[789]0-?\d{4}-?\d{4}(?!\d)",
        description: r"Japanese mobile phone (070/080/090)",
    ),
    PatternData(
        type_: r"phone",
        label: r"[電話番号]",
        pattern: r"0[1-9]\d{0,3}-?\d{1,4}-?\d{4}(?!\d)",
        validator: Some(r"jp_phone"),
        description: r"Japanese landline phone",
    ),
    PatternData(
        type_: r"my_number",
        label: r"[マイナンバー]",
        pattern: r"(?<!\d)\d{4}\s?\d{4}\s?\d{4}(?!\d)",
        validator: Some(r"my_number"),
        description: r"Japanese My Number (12 digits, check digit)",
    ),
]
