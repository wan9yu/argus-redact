__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
*.egg
.eggs/
.coverage
coverage.xml
htmlcov/
marketing/
tests/benchmark/data/*
# ...except the committed GB/T 2260 gazetteer source (reproducible record for
# data/regions/zh.ron, regenerated by tests/benchmark/gen_regions.py).
!tests/benchmark/data/gb2260.tsv
.claude/
_core*.so
*.dSYM/
target/
.venv/

# wasm-pack build output — a generated artifact (CI regenerates + attaches it to
# the GH release). wasm-pack also writes a pkg/.gitignore of `*`, but ignore it at
# the repo root too so no variant (bundler / nodejs / web out-dir) is ever staged.
crates/argus-redact-wasm/pkg/
crates/argus-redact-wasm/pkg-*/

# wasm-pack --target web output for the HF demo Space (built at deploy time, never committed)
demo/pkg-web/

# member-level lock files would shadow the workspace-root lock
crates/*/Cargo.lock

# Workspace-only design / planning artifacts (per convention — not committed)
docs/design-pseudonym-llm.md
docs/roadmap-v0.5.x.md
docs/superpowers/

# mutmut workspace (regenerated on every `mutmut run`)
mutants/
mutmut-stats.json

# cargo-mutants scratch output (regenerated on every `make mutants-core`)
mutants.out/
mutants.out.old/
mutants.out*/

# demo browser-test deps
tests/demo/node_modules/
tests/demo/test-results/
tests/demo/playwright-report/
tests/demo/package-lock.json
